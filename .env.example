# ---- App ----
APP_NAME=chaos
APP_ENV=development            # development | staging | production
PORT=8080
ALLOWED_ORIGINS=*              # comma-separated origins in production
RATE_LIMIT_RPM=120

# ---- Database (required) ----
DATABASE_URL=postgres://chaos:chaos@localhost:5432/chaos?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_LOG_QUERIES=false

# ---- Redis (optional in dev; enables caching + rate limiting) ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT (required) — use long random strings ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=chaos

# ---- Email ----
EMAIL_DRIVER=log               # log | smtp
EMAIL_FROM=hello@chaos.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Push notifications (FCM) ----
# Firebase service-account JSON. Empty = push disabled (server logs and runs on).
# --- Firebase (Apple / Google sign-in, push) ---
# The project ID alone switches on Sign in with Apple/Google: verifying an ID
# token uses Google's PUBLIC certificates, so no secret is needed for it.
FIREBASE_PROJECT_ID=chaos-f92dd
# Service-account JSON. Only needed for push, and for deleting a Firebase
# identity when someone deletes their account.
FIREBASE_CREDENTIALS_FILE=

# ---- Chaos (Azure OpenAI) ----
# Leave ENDPOINT or API_KEY empty and Chaos switches off cleanly: the app stays
# a working group chat, it just stops answering.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.1-chat
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Model calls per user per hour. Every message sent can trigger one, so this
# has to allow a real conversation while still bounding a runaway client.
AI_PER_HOUR_LIMIT=120
# A reply with comparison cards runs 10-30s; the 30s default is tight.
HTTP_WRITE_TIMEOUT=90s

# ---- Storage ----
STORAGE_DRIVER=local           # local | s3
STORAGE_LOCAL_DIR=./uploads
# Also the base for invite links: STORAGE_PUBLIC_BASE_URL/join/<id>
STORAGE_PUBLIC_BASE_URL=http://localhost:8080
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                   # set for Cloudflare R2 / MinIO
